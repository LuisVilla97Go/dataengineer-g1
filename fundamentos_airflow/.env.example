# PostgreSQL 18 instalado en Windows. Solo completa la primera contrasena.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=COMPLETA_AQUI_TU_CONTRASENA
POSTGRES_PORT=5432
POSTGRES_DB=airflow_tecsup
POSTGRES_PRACTICE_DB=tecsup_practica
POSTGRES_USER=airflow_tecsup
# GENERAR crea una clave independiente para Airflow y la conserva fuera del repositorio.
POSTGRES_PASSWORD=GENERAR
POSTGRES_SERVICE=postgresql-x64-18
POSTGRES_BIN=C:\Program Files\PostgreSQL\18\bin
WSL_DISTRIBUTION=Ubuntu-24.04
WSL_USER=luisa

# AIRFLOW_UID no se usa con Ubuntu/uv; el usuario local se indica en WSL_USER.
